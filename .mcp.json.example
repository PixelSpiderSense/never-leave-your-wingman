{
  "$comment": "Optional local MCP declarations. Slack/Notion are handoff mirrors. MarkItDown is local document conversion. Playwright is isolated headless browser evidence collection; it is not a security boundary and must not be used for external actions without explicit approval.",
  "mcpServers": {
    "slack": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-slack@2025.4.25"],
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${SLACK_TEAM_ID}",
        "SLACK_CHANNEL_IDS": "${SLACK_CHANNEL_ID}"
      }
    },
    "notion": {
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server@2.5.2"],
      "env": {
        "NOTION_API_KEY": "${NOTION_API_KEY}",
        "NOTION_DATABASE_ID": "${NOTION_DATABASE_ID}"
      }
    },
    "markitdown": {
      "command": "uvx",
      "args": ["--from", "markitdown-mcp==0.0.1a7", "markitdown-mcp"]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--isolated",
        "--block-service-workers",
        "--no-webmcp"
      ]
    }
  }
}
